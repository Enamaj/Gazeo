# ==============================================================================
# Variables d'Environnement Production GAZEO (Railway Pro)
# Remplir ces variables dans l'interface Railway > Variables
# NE JAMAIS COMMITER DE FICHIER CONTENANT DES CLÉS RÉELLES
# ==============================================================================

# Sécurité Django
SECRET_KEY=votre_cle_secrete_django_production_tres_longue_et_aleatoire
DEBUG=False
ALLOWED_HOSTS=api.gazeo.cm,gazeo-backend-production.up.railway.app,localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=https://gazeo.cm,https://admin.gazeo.cm

# Base de Données PostgreSQL + PostGIS (Fourni automatiquement par le plugin Railway Postgres)
DATABASE_URL=postgis://postgres:motdepasse@gazeo-postgres.railway.internal:5432/railway

# Cache & Broker Redis (Fourni automatiquement par le plugin Railway Redis)
REDIS_URL=redis://default:motdepasse@gazeo-redis.railway.internal:6379/1
CELERY_BROKER_URL=redis://default:motdepasse@gazeo-redis.railway.internal:6379/0
CELERY_RESULT_BACKEND=redis://default:motdepasse@gazeo-redis.railway.internal:6379/0

# Envoi de SMS Twilio (Production)
TWILIO_ACCOUNT_SID=ACXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX
TWILIO_AUTH_TOKEN=votre_token_twilio_secret
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=True

# Numéro Admin pour Alertes Critiques SMS (>3 échecs paiement Notchpay, commandes bloquées)
ADMIN_PHONE_NUMBER=+237699000000

# Passerelle de Paiement Mobile Money Notchpay (Production)
NOTCHPAY_PUBLIC_KEY=pk.production_notchpay_key_XXXXXXXXXXXXXXXX
NOTCHPAY_HASH=hash_notchpay_signature_production_secret

# Stockage Médias Cloudinary (KYC gérants, photos dépôts)
CLOUDINARY_CLOUD_NAME=gazeo_prod_cloud
CLOUDINARY_API_KEY=123456789012345
CLOUDINARY_API_SECRET=votre_secret_cloudinary_production

# Notifications Push Firebase Cloud Messaging
FIREBASE_CREDENTIALS=/app/serviceAccountKey.json

