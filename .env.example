# Django Configuration
DEBUG=True
SECRET_KEY=change-this-in-production-insecure-secret-key
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database (PostgreSQL / PostGIS)
DATABASE_URL=postgis://gazeo_user:gazeo_password@localhost:5432/gazeo_db

# Redis / Celery Cache & Tasks
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Twilio SMS OTP Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_ENABLED=False

# Cloudinary (KYC storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Notchpay (Mobile Money MTN / Orange)
NOTCHPAY_PUBLIC_KEY=sb.your_notchpay_public_key
NOTCHPAY_HASH=your_notchpay_webhook_hash

# Firebase Cloud Messaging
FCM_CREDENTIALS_PATH=

